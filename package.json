{
  "name": "@fuzdev/zap",
  "version": "0.0.1",
  "description": "convergent machine-state management: set up and ship to Linux machines from TypeScript",
  "glyph": "↯",
  "logo": "logo.svg",
  "logo_alt": "a friendly orange spider haloed by lightning bolts",
  "license": "0BSD",
  "private": true,
  "homepage": "https://zap.fuz.dev/",
  "repository": "https://github.com/fuzdev/zap",
  "scripts": {
    "start": "gro dev",
    "dev": "gro dev",
    "build": "gro build",
    "check": "gro check",
    "test": "gro test",
    "preview": "vite preview",
    "deploy": "gro deploy"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#routes/*": "./src/routes/*"
  },
  "engines": {
    "node": ">=24.14"
  },
  "devDependencies": {
    "@fuzdev/blake3-wasm": "^0.2.0",
    "@fuzdev/fuz_code": "^0.59.0",
    "@fuzdev/fuz_css": "^0.81.0",
    "@fuzdev/fuz_schema": "^0.5.6",
    "@fuzdev/fuz_ui": "^0.227.0",
    "@fuzdev/fuz_util": "^0.81.0",
    "@fuzdev/gro": "^0.229.0",
    "@fuzdev/mdz": "^0.9.0",
    "@ryanatkn/eslint-config": "^0.13.2",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/package": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/estree": "^1.0.9",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.23.1",
    "esm-env": "^1.2.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-docinfo": "^0.17.0",
    "svelte2tsx": "^0.7.61",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/lib/**/*.ts",
    "!src/lib/**/*.test.*",
    "!dist/**/*.test.*"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./*.js": {
      "gro": "./src/lib/*.ts",
      "deno": "./src/lib/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.ts": {
      "gro": "./src/lib/*.ts",
      "deno": "./src/lib/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  }
}
