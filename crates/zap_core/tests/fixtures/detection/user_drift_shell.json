{
  "resource": {
    "id": "deploy-user",
    "type": "user",
    "name": "create deploy user",
    "username": "deploy",
    "shell": "/bin/bash"
  },
  "target": {
    "local": true
  },
  "observed": [
    {
      "query": {
        "type": "command",
        "snippet": "id -u -- 'deploy'",
        "privilege": "login",
        "timeout_secs": 60
      },
      "observation": {
        "command": {
          "code": 0,
          "stdout": "1001\n",
          "stderr": ""
        }
      }
    },
    {
      "query": {
        "type": "command",
        "snippet": "awk -F: -v u='deploy' '$1\"\"==u{print $7}' /etc/passwd",
        "privilege": "login",
        "timeout_secs": 60
      },
      "observation": {
        "command": {
          "code": 0,
          "stdout": "/bin/sh\n",
          "stderr": ""
        }
      }
    }
  ],
  "expected": {
    "outcome": "drifted",
    "current": {
      "kind": "user",
      "drift": {
        "shell": "/bin/sh"
      }
    }
  }
}
