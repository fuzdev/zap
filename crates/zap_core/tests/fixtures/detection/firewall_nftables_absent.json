{
  "resource": {
    "id": "nftables-firewall",
    "type": "firewall",
    "name": "configure firewall",
    "backend": "nftables",
    "allow": [
      {
        "port": 22,
        "proto": "tcp"
      }
    ]
  },
  "target": {
    "local": true
  },
  "observed": [
    {
      "query": {
        "type": "command",
        "snippet": "exec nft list table inet filter",
        "privilege": "root",
        "timeout_secs": 60
      },
      "observation": {
        "command": {
          "code": 1,
          "stdout": "",
          "stderr": "Error: No such file or directory"
        }
      }
    }
  ],
  "expected": {
    "outcome": "absent"
  }
}
