{
  "resource": {
    "id": "deploy-user",
    "type": "user",
    "name": "create deploy user",
    "username": "deploy",
    "shell": "/bin/bash",
    "home_mode": "711",
    "ssh_keys": {
      "copy_from": "root"
    },
    "sudo": "nopasswd"
  },
  "target": {
    "local": true
  },
  "observed": [
    {
      "query": {
        "type": "command",
        "snippet": "id -u -- 'deploy'",
        "privilege": "login",
        "timeout_secs": 60
      },
      "observation": {
        "command": {
          "code": 0,
          "stdout": "1001\n",
          "stderr": ""
        }
      }
    },
    {
      "query": {
        "type": "command",
        "snippet": "awk -F: -v u='deploy' '$1\"\"==u{print $7}' /etc/passwd",
        "privilege": "login",
        "timeout_secs": 60
      },
      "observation": {
        "command": {
          "code": 0,
          "stdout": "/bin/bash\n",
          "stderr": ""
        }
      }
    },
    {
      "query": {
        "type": "command",
        "snippet": "awk -F: -v u='deploy' '$1\"\"==u{print $6}' /etc/passwd",
        "privilege": "login",
        "timeout_secs": 60
      },
      "observation": {
        "command": {
          "code": 0,
          "stdout": "/home/deploy\n",
          "stderr": ""
        }
      }
    },
    {
      "query": {
        "type": "command",
        "snippet": "if [ -e '/home/deploy' ] || [ -L '/home/deploy' ]; then exec stat -c '%f %u %g' -- '/home/deploy'; elif [ -d /home ] && [ -x /home ]; then echo absent; else exit 94; fi",
        "privilege": "login",
        "timeout_secs": 60
      },
      "observation": {
        "command": {
          "code": 0,
          "stdout": "41ed 1001 1001\n",
          "stderr": ""
        }
      }
    },
    {
      "query": {
        "type": "command",
        "snippet": "stat -c '%a' -- '/home/deploy'",
        "privilege": "login",
        "timeout_secs": 60
      },
      "observation": {
        "command": {
          "code": 0,
          "stdout": "711\n",
          "stderr": ""
        }
      }
    },
    {
      "query": {
        "type": "command",
        "snippet": "SRC_HOME=$(awk -F: -v u='root' '$1\"\"==u{print $6}' /etc/passwd) && [ -n \"$SRC_HOME\" ] || exit 3; exec sudo -u 'root' head -c 1048577 -- \"$SRC_HOME/.ssh/authorized_keys\"",
        "privilege": "root",
        "timeout_secs": 60
      },
      "observation": {
        "command": {
          "code": 0,
          "stdout": "ssh-ed25519 AAAAroot root@host\n",
          "stderr": ""
        }
      }
    },
    {
      "query": {
        "type": "command",
        "snippet": "[ ! -L '/home/deploy/.ssh/authorized_keys' ] || exit 3; [ ! -e '/home/deploy/.ssh/authorized_keys' ] || [ -f '/home/deploy/.ssh/authorized_keys' ] || exit 3; exec sudo -u 'deploy' head -c 1048577 -- '/home/deploy/.ssh/authorized_keys'",
        "privilege": "root",
        "timeout_secs": 60
      },
      "observation": {
        "command": {
          "code": 0,
          "stdout": "ssh-ed25519 AAAAroot root@host\n",
          "stderr": ""
        }
      }
    },
    {
      "query": {
        "type": "command",
        "snippet": "exec awk -F: -v u='deploy' '$1\"\"==u{print $2}' /etc/shadow",
        "privilege": "root",
        "timeout_secs": 60
      },
      "observation": {
        "command": {
          "code": 0,
          "stdout": "!\n",
          "stderr": ""
        }
      }
    },
    {
      "query": {
        "type": "command",
        "snippet": "test -f '/etc/sudoers.d/deploy'",
        "privilege": "root",
        "timeout_secs": 60
      },
      "observation": {
        "command": {
          "code": 0,
          "stdout": "",
          "stderr": ""
        }
      }
    },
    {
      "query": {
        "type": "path",
        "path": "/etc/sudoers.d/deploy",
        "facet": {
          "read": {
            "max": 65536
          }
        },
        "privilege": "elevated"
      },
      "observation": {
        "contents": {
          "bytes": "deploy ALL=(ALL) NOPASSWD: ALL\n",
          "truncated": false
        }
      }
    }
  ],
  "expected": {
    "outcome": "drifted",
    "current": {
      "kind": "user",
      "drift": {
        "shadow_password": "not_disabled"
      }
    }
  }
}
